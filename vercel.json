{
  "redirects": [
    {
      "source": "/api/bwf/sso/start",
      "destination": "https://bwteam-project.com/api/bwf/sso/start",
      "permanent": false
    }
  ],
  "functions": {
    "api/pdf-split.ts": {
      "maxDuration": 800,
      "memory": 3009
    }
  },
  "crons": [
    { "path": "/api/pdf-split", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/((?!assets/|fonts/|robots.txt|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        {
          "key": "Permissions-Policy",
          "value": "clipboard-read=(*), clipboard-write=(*)"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
