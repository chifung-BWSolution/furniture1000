# Copy to .env.local — do NOT commit secrets.
# SUPABASE_ACCESS_TOKEN: set once in Windows User environment variables (not in files).

# Furniture 1000 Supabase (riaubhtruisbwdlwjzur)
VITE_SUPABASE_URL=https://riaubhtruisbwdlwjzur.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PROJECT_REF=riaubhtruisbwdlwjzur

# Optional: master project reads (kqwktnplkqucsbasyfjl)
VITE_MASTER_SUPABASE_ANON_KEY=

# PMS SSO — user clicks "使用 PMS 登入" → PMS3.0 start route (see PMS3.0 repo)
# Example: https://your-pms3-app.com/bwf/sso/start
# Repo: https://github.com/chifung-BWSolution/PMS3.0
VITE_PMS_SSO_START_URL=

# Edge function secrets (Supabase dashboard → Edge Functions → Secrets, NOT in frontend):
# SUPABASE_SERVICE_ROLE_KEY — auto-injected
# PMS_SSO_SHARED_SECRET — shared with PMS server; required for mint action
# FURNITURE_APP_URL — e.g. https://www.bwteam-furniture.com (used when minting exchange_url)
